[
  {
    "id": "a1b2c3d4-0001-0001-0001-000000000001",
    "name": "OESN — New Referral Notification",
    "nodes": [
      {
        "id": "n1",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "parameters": {
          "httpMethod": "POST",
          "path": "oesn/new-referral",
          "responseMode": "responseNode",
          "options": {}
        }
      },
      {
        "id": "n2",
        "name": "Notify Provider via Glific",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 200],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "flow_id": "YOUR_GLIFIC_PROVIDER_FLOW_ID",
            "contact_id": "={{ $json.provider_glific_id }}",
            "fields": {
              "service_name":  "={{ $json.service_name }}",
              "sector":        "={{ $json.sector }}",
              "commission":    "={{ $json.commission }}",
              "deadline_days": "={{ $json.deadline_days }}"
            }
          },
          "options": {}
        }
      },
      {
        "id": "n3",
        "name": "Notify Agent via Glific",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 400],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "flow_id": "YOUR_GLIFIC_AGENT_FLOW_ID",
            "contact_id": "={{ $json.agent_glific_id }}",
            "fields": {
              "service_name": "={{ $json.service_name }}",
              "referral_id":  "={{ $json.referral_id }}"
            }
          },
          "options": {}
        }
      },
      {
        "id": "n4",
        "name": "Log to Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [720, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/whatsapp_messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_ANON_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_ANON_KEY" },
              { "name": "Content-Type",  "value": "application/json" },
              { "name": "Prefer",        "value": "return=minimal" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "referral_id":   "={{ $('Webhook').item.json.referral_id }}",
            "direction":     "outbound",
            "content":       "Referral notification sent to provider and agent",
            "message_type":  "notification"
          },
          "options": {}
        }
      },
      {
        "id": "n5",
        "name": "Respond to Webhook",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [960, 300],
        "parameters": {
          "respondWith": "json",
          "responseBody": "{\"ok\": true, \"message\": \"Notifications sent\"}"
        }
      }
    ],
    "connections": {
      "Webhook": {
        "main": [
          [
            { "node": "Notify Provider via Glific", "type": "main", "index": 0 },
            { "node": "Notify Agent via Glific",    "type": "main", "index": 0 }
          ]
        ]
      },
      "Notify Provider via Glific": {
        "main": [[{ "node": "Log to Supabase", "type": "main", "index": 0 }]]
      },
      "Notify Agent via Glific": {
        "main": [[{ "node": "Log to Supabase", "type": "main", "index": 0 }]]
      },
      "Log to Supabase": {
        "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
      }
    },
    "active": false,
    "settings": { "executionOrder": "v1" },
    "versionId": "a1b2c3d4-ver1-0001-0001-000000000001",
    "meta": { "instanceId": "your-n8n-instance-id" }
  },

  {
    "id": "a1b2c3d4-0002-0002-0002-000000000002",
    "name": "OESN — Weekly Agent Digest",
    "nodes": [
      {
        "id": "n1",
        "name": "Every Monday 7am IST",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1,
        "position": [240, 300],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "30 1 * * 1"
              }
            ]
          }
        }
      },
      {
        "id": "n2",
        "name": "Fetch All Agents",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 300],
        "parameters": {
          "method": "GET",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/agents?select=id,name,phone&active=eq.true",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "n3",
        "name": "Split by Agent",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [720, 300],
        "parameters": { "batchSize": 1, "options": {} }
      },
      {
        "id": "n4",
        "name": "Fetch Agent Dashboard",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [960, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/rpc/get_agent_dashboard",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": { "agent_uuid": "={{ $json.id }}" },
          "options": {}
        }
      },
      {
        "id": "n5",
        "name": "Format Monday Digest",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1200, 300],
        "parameters": {
          "jsCode": "const agent = $('Split by Agent').item.json;\nconst dash  = $input.item.json;\n\nconst overdue    = dash.overdue_count || 0;\nconst pending    = dash.pending_earnings_total || 0;\nconst dormant    = dash.dormant_entrepreneurs || 0;\nconst rtcCount   = (dash.referrals_by_status || {}).RTC || 0;\n\nconst lines = [\n  `🌅 Good morning ${agent.name}! Here's your OESN week ahead:`,\n  ``,\n  `🔴 Overdue referrals: ${overdue}`,\n  `🟡 Ready to Close (verify these): ${rtcCount}`,\n  `😴 Dormant entrepreneurs (14+ days): ${dormant}`,\n  `💰 Pending earnings: ₹${pending.toLocaleString('en-IN')}`,\n  ``,\n  `Open the OESN app to action these. Have a great week!`\n];\n\nreturn [{\n  json: {\n    agent_id:    agent.id,\n    agent_phone: agent.phone,\n    message:     lines.join('\\n')\n  }\n}];"
        }
      },
      {
        "id": "n6",
        "name": "Send WhatsApp Digest",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1440, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "flow_id":   "YOUR_GLIFIC_DIGEST_FLOW_ID",
            "phone":     "={{ $json.agent_phone }}",
            "fields": {
              "message": "={{ $json.message }}"
            }
          },
          "options": {}
        }
      }
    ],
    "connections": {
      "Every Monday 7am IST": {
        "main": [[{ "node": "Fetch All Agents", "type": "main", "index": 0 }]]
      },
      "Fetch All Agents": {
        "main": [[{ "node": "Split by Agent", "type": "main", "index": 0 }]]
      },
      "Split by Agent": {
        "main": [[{ "node": "Fetch Agent Dashboard", "type": "main", "index": 0 }]]
      },
      "Fetch Agent Dashboard": {
        "main": [[{ "node": "Format Monday Digest", "type": "main", "index": 0 }]]
      },
      "Format Monday Digest": {
        "main": [[{ "node": "Send WhatsApp Digest", "type": "main", "index": 0 }]]
      },
      "Send WhatsApp Digest": {
        "main": [[{ "node": "Split by Agent", "type": "main", "index": 1 }]]
      }
    },
    "active": false,
    "settings": { "executionOrder": "v1" },
    "versionId": "a1b2c3d4-ver2-0002-0002-000000000002",
    "meta": { "instanceId": "your-n8n-instance-id" }
  },

  {
    "id": "a1b2c3d4-0003-0003-0003-000000000003",
    "name": "OESN — Entrepreneur Status Chatbot",
    "nodes": [
      {
        "id": "n1",
        "name": "Inbound WhatsApp",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "parameters": {
          "httpMethod": "POST",
          "path": "oesn/glific-inbound",
          "responseMode": "responseNode",
          "options": {}
        }
      },
      {
        "id": "n2",
        "name": "Intent Switch",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [480, 300],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": { "caseSensitive": false },
                  "combinator": "or",
                  "conditions": [
                    { "leftValue": "={{ $json.message_text }}", "rightValue": "status",   "operator": { "type": "string", "operation": "contains" } },
                    { "leftValue": "={{ $json.message_text }}", "rightValue": "referral", "operator": { "type": "string", "operation": "contains" } },
                    { "leftValue": "={{ $json.message_text }}", "rightValue": "update",   "operator": { "type": "string", "operation": "contains" } }
                  ]
                },
                "renameOutput": true,
                "outputKey": "status_request"
              }
            ]
          },
          "fallbackOutput": "extra",
          "options": {}
        }
      },
      {
        "id": "n3",
        "name": "Lookup Entrepreneur",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [720, 200],
        "parameters": {
          "method": "GET",
          "url": "=https://YOUR_SUPABASE_URL/rest/v1/entrepreneurs?phone=eq.{{ $('Inbound WhatsApp').item.json.from_phone }}&select=id,name,agent_id,status",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "n4",
        "name": "Check Entrepreneur Found",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [960, 200],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "conditions": [
                    { "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
                  ]
                },
                "renameOutput": true,
                "outputKey": "found"
              }
            ]
          },
          "fallbackOutput": "extra",
          "options": {}
        }
      },
      {
        "id": "n5",
        "name": "Fetch Referrals",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1200, 160],
        "parameters": {
          "method": "GET",
          "url": "=https://YOUR_SUPABASE_URL/rest/v1/referrals?entrepreneur_id=eq.{{ $json[0].id }}&select=service_name,status,deadline_date,updated_at&order=updated_at.desc&limit=3",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "n6",
        "name": "Format Status Reply",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1440, 160],
        "parameters": {
          "jsCode": "const referrals = $input.all();\nconst contact_id = $('Inbound WhatsApp').item.json.contact_id;\n\nif (!referrals || referrals.length === 0) {\n  return [{ json: { contact_id, reply: 'No active referrals found for your number. Please contact your field agent.' } }];\n}\n\nconst statusEmoji = { IN_PROGRESS: '🔵', RTC: '🟡', COMPLETED: '✅', OVERDUE: '🔴', BLOCKED: '🚫', DISPUTED: '⚠️' };\n\nconst lines = ['📋 Your referral status:'];\nreferrals.forEach(r => {\n  const item = r.json;\n  const emoji = statusEmoji[item.status] || '⚪';\n  const date  = item.updated_at ? new Date(item.updated_at).toLocaleDateString('en-IN') : '';\n  lines.push(`${emoji} ${item.service_name}: ${item.status}${date ? ' (updated ' + date + ')' : ''}`);\n});\nlines.push('');\nlines.push('Reply HELP to contact your agent.');\n\nreturn [{ json: { contact_id, reply: lines.join('\\n') } }];"
        }
      },
      {
        "id": "n7",
        "name": "Send Status Reply",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1680, 160],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $json.contact_id }}",
            "message":    "={{ $json.reply }}"
          },
          "options": {}
        }
      },
      {
        "id": "n8",
        "name": "Send Not Found Reply",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1200, 360],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $('Inbound WhatsApp').item.json.contact_id }}",
            "message":    "We couldn't find your number in the OESN system. Please contact your field agent to register."
          },
          "options": {}
        }
      },
      {
        "id": "n9",
        "name": "Send Help Message",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [720, 440],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $('Inbound WhatsApp').item.json.contact_id }}",
            "message":    "👋 Hi! I'm the OESN assistant.\n\nType:\n• STATUS — to see your referral status\n• HELP — to get your agent's contact\n\nFor urgent matters, contact your field agent directly."
          },
          "options": {}
        }
      },
      {
        "id": "n10",
        "name": "Respond OK",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1920, 300],
        "parameters": {
          "respondWith": "json",
          "responseBody": "{\"ok\": true}"
        }
      }
    ],
    "connections": {
      "Inbound WhatsApp": {
        "main": [[{ "node": "Intent Switch", "type": "main", "index": 0 }]]
      },
      "Intent Switch": {
        "main": [
          [{ "node": "Lookup Entrepreneur", "type": "main", "index": 0 }],
          [{ "node": "Send Help Message",   "type": "main", "index": 0 }]
        ]
      },
      "Lookup Entrepreneur": {
        "main": [[{ "node": "Check Entrepreneur Found", "type": "main", "index": 0 }]]
      },
      "Check Entrepreneur Found": {
        "main": [
          [{ "node": "Fetch Referrals",      "type": "main", "index": 0 }],
          [{ "node": "Send Not Found Reply", "type": "main", "index": 0 }]
        ]
      },
      "Fetch Referrals": {
        "main": [[{ "node": "Format Status Reply", "type": "main", "index": 0 }]]
      },
      "Format Status Reply": {
        "main": [[{ "node": "Send Status Reply", "type": "main", "index": 0 }]]
      },
      "Send Status Reply":    { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
      "Send Not Found Reply": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
      "Send Help Message":    { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
    },
    "active": false,
    "settings": { "executionOrder": "v1" },
    "versionId": "a1b2c3d4-ver3-0003-0003-000000000003",
    "meta": { "instanceId": "your-n8n-instance-id" }
  }
]
