[
  {
    "id": "f1a2b3c4-d5e6-7890-abcd-ef1234560001",
    "name": "OESN — New Referral Notification",
    "nodes": [
      {
        "id": "aa000001-0000-0000-0000-000000000001",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "parameters": {
          "httpMethod": "POST",
          "path": "oesn/new-referral",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "oesn-new-referral-hook"
      },
      {
        "id": "aa000001-0000-0000-0000-000000000002",
        "name": "Notify Provider via Glific",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [520, 160],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "phone":   "={{ $json.provider_phone }}",
            "message": "=New referral: {{ $json.service_name }} for entrepreneur in {{ $json.sector }}. Commission: ₹{{ $json.commission }}. Deadline: {{ $json.deadline_days }} days. Login to OESN to view details and accept."
          },
          "options": {}
        }
      },
      {
        "id": "aa000001-0000-0000-0000-000000000003",
        "name": "Notify Agent via Glific",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [520, 440],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "phone":   "={{ $('Webhook').item.json.agent_phone }}",
            "message": "=Referral created successfully for {{ $('Webhook').item.json.service_name }}. Provider notified on WhatsApp."
          },
          "options": {}
        }
      },
      {
        "id": "aa000001-0000-0000-0000-000000000004",
        "name": "Log to Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [800, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/whatsapp_messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Content-Type",  "value": "application/json" },
              { "name": "Prefer",        "value": "return=minimal" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "referral_id":    "={{ $('Webhook').item.json.referral_id }}",
            "entrepreneur_id":"={{ $('Webhook').item.json.entrepreneur_id }}",
            "agent_id":       "={{ $('Webhook').item.json.agent_id }}",
            "direction":      "outbound",
            "content":        "=Referral notification sent to provider and agent for {{ $('Webhook').item.json.service_name }}",
            "message_type":   "notification"
          },
          "options": {}
        }
      },
      {
        "id": "aa000001-0000-0000-0000-000000000005",
        "name": "Respond to Webhook",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1060, 300],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={ \"ok\": true, \"message\": \"Notifications dispatched\", \"referral_id\": \"{{ $('Webhook').item.json.referral_id }}\" }"
        }
      }
    ],
    "connections": {
      "Webhook": {
        "main": [
          [
            { "node": "Notify Provider via Glific", "type": "main", "index": 0 },
            { "node": "Notify Agent via Glific",    "type": "main", "index": 0 }
          ]
        ]
      },
      "Notify Provider via Glific": {
        "main": [[{ "node": "Log to Supabase", "type": "main", "index": 0 }]]
      },
      "Notify Agent via Glific": {
        "main": [[{ "node": "Log to Supabase", "type": "main", "index": 0 }]]
      },
      "Log to Supabase": {
        "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
      }
    },
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "saveManualExecutions": true,
      "callerPolicy": "workflowsFromSameOwner"
    },
    "versionId": "f1a2b3c4-d5e6-7890-abcd-ef1234560001",
    "meta": {
      "instanceId": "YOUR_N8N_INSTANCE_ID",
      "templateCredsSetupCompleted": true
    },
    "tags": [{ "name": "oesn" }]
  },

  {
    "id": "f1a2b3c4-d5e6-7890-abcd-ef1234560002",
    "name": "OESN — Weekly Agent Digest",
    "nodes": [
      {
        "id": "aa000002-0000-0000-0000-000000000001",
        "name": "Every Monday 7am IST",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1,
        "position": [240, 300],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "30 1 * * 1"
              }
            ]
          }
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000002",
        "name": "Fetch All Active Agents",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [480, 300],
        "parameters": {
          "method": "GET",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/agents?select=id,name,phone,geography,operating_model&active=eq.true",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Accept",        "value": "application/json" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000003",
        "name": "Split by Agent",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [720, 300],
        "parameters": {
          "batchSize": 1,
          "options": {}
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000004",
        "name": "Fetch Agent Dashboard",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [960, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_SUPABASE_URL/rest/v1/rpc/get_agent_dashboard",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "agent_uuid": "={{ $json.id }}"
          },
          "options": {}
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000005",
        "name": "Format Monday Digest",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1200, 300],
        "parameters": {
          "jsCode": "// agent item from the Split node\nconst agent = $('Split by Agent').item.json;\n// dashboard data from Supabase RPC\nconst dash = $input.item.json;\n\nconst overdue  = dash.overdue_referral_count   || 0;\nconst pending  = dash.pending_earnings_total   || 0;\nconst dormant  = dash.dormant_entrepreneurs    || 0;\nconst active   = dash.active_entrepreneurs     || 0;\nconst byStatus = dash.referrals_by_status      || {};\nconst rtc      = byStatus.RTC                  || 0;\nconst blocked  = byStatus.BLOCKED              || 0;\nconst tasks    = dash.upcoming_tasks           || [];\n\nconst taskLines = tasks.length > 0\n  ? tasks.map(t => `  • [${t.task_type}] ${t.note || 'No note'} — due ${t.due_date}`).join('\\n')\n  : '  No urgent tasks this week.';\n\nconst message = [\n  `Good morning ${agent.name}! Here's your OESN week ahead.`,\n  ``,\n  `👥 Active entrepreneurs: ${active}`,\n  `😴 Dormant (not contacted): ${dormant}`,\n  ``,\n  `📋 Referrals:`,\n  `  🔴 Overdue: ${overdue}`,\n  `  🟡 Ready to Close (needs your verification): ${rtc}`,\n  `  🚫 Blocked: ${blocked}`,\n  ``,\n  `💰 Pending earnings: ₹${(pending).toLocaleString('en-IN')}`,\n  ``,\n  `✅ This week's tasks:`,\n  taskLines,\n  ``,\n  `Open OESN to action these. Have a great week!`\n].join('\\n');\n\nreturn [{\n  json: {\n    agent_id:    agent.id,\n    agent_name:  agent.name,\n    agent_phone: agent.phone,\n    message\n  }\n}];"
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000006",
        "name": "Send WhatsApp Digest",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1440, 300],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "phone":   "={{ $json.agent_phone }}",
            "message": "={{ $json.message }}"
          },
          "options": {}
        }
      },
      {
        "id": "aa000002-0000-0000-0000-000000000007",
        "name": "Log Digest Sent",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3,
        "position": [1680, 300],
        "parameters": {
          "mode": "manual",
          "duplicateItem": false,
          "assignments": {
            "assignments": [
              {
                "id": "log-agent-id",
                "name": "agent_id",
                "value": "={{ $('Format Monday Digest').item.json.agent_id }}",
                "type": "string"
              },
              {
                "id": "log-agent-name",
                "name": "agent_name",
                "value": "={{ $('Format Monday Digest').item.json.agent_name }}",
                "type": "string"
              },
              {
                "id": "log-sent-at",
                "name": "sent_at",
                "value": "={{ $now.toISO() }}",
                "type": "string"
              },
              {
                "id": "log-status",
                "name": "status",
                "value": "digest_sent",
                "type": "string"
              }
            ]
          },
          "options": {}
        }
      }
    ],
    "connections": {
      "Every Monday 7am IST": {
        "main": [[{ "node": "Fetch All Active Agents", "type": "main", "index": 0 }]]
      },
      "Fetch All Active Agents": {
        "main": [[{ "node": "Split by Agent", "type": "main", "index": 0 }]]
      },
      "Split by Agent": {
        "main": [[{ "node": "Fetch Agent Dashboard", "type": "main", "index": 0 }]]
      },
      "Fetch Agent Dashboard": {
        "main": [[{ "node": "Format Monday Digest", "type": "main", "index": 0 }]]
      },
      "Format Monday Digest": {
        "main": [[{ "node": "Send WhatsApp Digest", "type": "main", "index": 0 }]]
      },
      "Send WhatsApp Digest": {
        "main": [
          [
            { "node": "Log Digest Sent", "type": "main", "index": 0 },
            { "node": "Split by Agent",  "type": "main", "index": 1 }
          ]
        ]
      }
    },
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "saveManualExecutions": true,
      "callerPolicy": "workflowsFromSameOwner"
    },
    "versionId": "f1a2b3c4-d5e6-7890-abcd-ef1234560002",
    "meta": {
      "instanceId": "YOUR_N8N_INSTANCE_ID",
      "templateCredsSetupCompleted": true
    },
    "tags": [{ "name": "oesn" }]
  },

  {
    "id": "f1a2b3c4-d5e6-7890-abcd-ef1234560003",
    "name": "OESN — Entrepreneur Status Chatbot",
    "nodes": [
      {
        "id": "aa000003-0000-0000-0000-000000000001",
        "name": "Inbound WhatsApp",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 340],
        "parameters": {
          "httpMethod": "POST",
          "path": "oesn/glific-inbound",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "oesn-glific-inbound-hook"
      },
      {
        "id": "aa000003-0000-0000-0000-000000000002",
        "name": "Intent Switch",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [480, 340],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": { "caseSensitive": false },
                  "combinator": "or",
                  "conditions": [
                    {
                      "leftValue":  "={{ $json.message_text }}",
                      "rightValue": "status",
                      "operator": { "type": "string", "operation": "contains" }
                    },
                    {
                      "leftValue":  "={{ $json.message_text }}",
                      "rightValue": "referral",
                      "operator": { "type": "string", "operation": "contains" }
                    },
                    {
                      "leftValue":  "={{ $json.message_text }}",
                      "rightValue": "update",
                      "operator": { "type": "string", "operation": "contains" }
                    }
                  ]
                },
                "renameOutput": true,
                "outputKey": "status_request"
              }
            ]
          },
          "fallbackOutput": "extra",
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000003",
        "name": "Lookup Entrepreneur",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [720, 200],
        "parameters": {
          "method": "GET",
          "url": "=https://YOUR_SUPABASE_URL/rest/v1/entrepreneurs?phone=eq.{{ $('Inbound WhatsApp').item.json.from_phone }}&select=id,name,agent_id,sector,status&limit=1",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Accept",        "value": "application/json" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000004",
        "name": "Entrepreneur Found?",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [960, 200],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "conditions": [
                    {
                      "leftValue":  "={{ Array.isArray($json) ? $json.length : ($json.id ? 1 : 0) }}",
                      "rightValue": 0,
                      "operator": { "type": "number", "operation": "gt" }
                    }
                  ]
                },
                "renameOutput": true,
                "outputKey": "found"
              }
            ]
          },
          "fallbackOutput": "extra",
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000005",
        "name": "Fetch Referrals",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1200, 120],
        "parameters": {
          "method": "GET",
          "url": "=https://YOUR_SUPABASE_URL/rest/v1/referrals?entrepreneur_id=eq.{{ Array.isArray($json) ? $json[0].id : $json.id }}&select=service_name,status,deadline_date,provider_last_update,blocker_reason&order=created_at.desc&limit=5",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "apikey",        "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY" },
              { "name": "Accept",        "value": "application/json" }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000006",
        "name": "Format Status Reply",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1440, 120],
        "parameters": {
          "jsCode": "const contact_id  = $('Inbound WhatsApp').item.json.contact_id;\nconst from_phone  = $('Inbound WhatsApp').item.json.from_phone;\nconst referrals   = $input.all();\n\nconst statusEmoji = {\n  IN_PROGRESS: '🔵',\n  RTC:         '🟡',\n  COMPLETED:   '✅',\n  OVERDUE:     '🔴',\n  BLOCKED:     '🚫',\n  DISPUTED:    '⚠️'\n};\n\nif (!referrals || referrals.length === 0 || (referrals.length === 1 && !referrals[0].json.service_name)) {\n  return [{\n    json: {\n      contact_id,\n      reply: 'No referrals found for your number. Please contact your field agent for updates.'\n    }\n  }];\n}\n\nconst lines = ['📋 Your referral status:'];\nfor (const item of referrals) {\n  const r     = item.json;\n  const emoji = statusEmoji[r.status] || '⚪';\n  const date  = r.provider_last_update\n    ? 'Last update: ' + new Date(r.provider_last_update).toLocaleDateString('en-IN', {day:'2-digit',month:'short'})\n    : (r.deadline_date ? 'Deadline: ' + r.deadline_date : '');\n  lines.push(`${emoji} ${r.service_name}: *${r.status}*`);\n  if (date)             lines.push(`   ${date}`);\n  if (r.blocker_reason) lines.push(`   ⚠️ Blocker: ${r.blocker_reason}`);\n}\nlines.push('');\nlines.push('Reply HELP to reach your field agent.');\n\nreturn [{\n  json: {\n    contact_id,\n    reply: lines.join('\\n')\n  }\n}];"
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000007",
        "name": "Send Status Reply",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1680, 120],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $json.contact_id }}",
            "message":    "={{ $json.reply }}"
          },
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000008",
        "name": "Send Not Found Reply",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1200, 340],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $('Inbound WhatsApp').item.json.contact_id }}",
            "message":    "We couldn't find your number in the OESN system. Please contact your field agent to register and get help."
          },
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000009",
        "name": "Send Help Message",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [720, 500],
        "parameters": {
          "method": "POST",
          "url": "https://YOUR_GLIFIC_URL/api/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Authorization", "value": "Bearer YOUR_GLIFIC_API_KEY" },
              { "name": "Content-Type",  "value": "application/json" }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "body": {
            "contact_id": "={{ $('Inbound WhatsApp').item.json.contact_id }}",
            "message":    "Hi! I'm the OESN assistant.\n\nType:\n• STATUS — to see your referral updates\n• REFERRAL — to check a specific service\n\nFor urgent help, contact your field agent directly."
          },
          "options": {}
        }
      },
      {
        "id": "aa000003-0000-0000-0000-000000000010",
        "name": "Respond OK",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1960, 340],
        "parameters": {
          "respondWith": "json",
          "responseBody": "{ \"ok\": true }"
        }
      }
    ],
    "connections": {
      "Inbound WhatsApp": {
        "main": [[{ "node": "Intent Switch", "type": "main", "index": 0 }]]
      },
      "Intent Switch": {
        "main": [
          [{ "node": "Lookup Entrepreneur", "type": "main", "index": 0 }],
          [{ "node": "Send Help Message",   "type": "main", "index": 0 }]
        ]
      },
      "Lookup Entrepreneur": {
        "main": [[{ "node": "Entrepreneur Found?", "type": "main", "index": 0 }]]
      },
      "Entrepreneur Found?": {
        "main": [
          [{ "node": "Fetch Referrals",      "type": "main", "index": 0 }],
          [{ "node": "Send Not Found Reply", "type": "main", "index": 0 }]
        ]
      },
      "Fetch Referrals": {
        "main": [[{ "node": "Format Status Reply", "type": "main", "index": 0 }]]
      },
      "Format Status Reply": {
        "main": [[{ "node": "Send Status Reply", "type": "main", "index": 0 }]]
      },
      "Send Status Reply":    { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
      "Send Not Found Reply": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
      "Send Help Message":    { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
    },
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "saveManualExecutions": true,
      "callerPolicy": "workflowsFromSameOwner"
    },
    "versionId": "f1a2b3c4-d5e6-7890-abcd-ef1234560003",
    "meta": {
      "instanceId": "YOUR_N8N_INSTANCE_ID",
      "templateCredsSetupCompleted": true
    },
    "tags": [{ "name": "oesn" }]
  }
]
