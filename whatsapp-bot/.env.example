# Twilio credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Base URL where this app is deployed (used to serve PDF/media files)
# e.g. https://your-app.railway.app
BASE_URL=https://your-app.railway.app

# Delivery schedule: days of week (0=Mon, 1=Tue ... 6=Sun), comma-separated
# Default: Monday and Thursday
DELIVERY_DAYS=0,3
# Hour of day to send (24h, UTC)
DELIVERY_HOUR=9

# Optional: Admin phone (gets error alerts), e.g. whatsapp:+919876543210
ADMIN_PHONE=

# Database file path
DATABASE_URL=sqlite+aiosqlite:///./stories.db
