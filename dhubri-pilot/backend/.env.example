# Dhubri Pilot backend — environment variables
# Copy to .env and fill in real values, or set these as Supabase Edge Function secrets:
#   supabase secrets set --env-file .env

# Supabase (schema.sql's project) — service role bypasses RLS, keep this secret server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Glific — WhatsApp via Gupshup BSP (GLIFIC_SETUP.md §3)
GLIFIC_API_URL=              # e.g. https://api.<your-org>.glific.com
GLIFIC_PHONE=                # phone number of a Glific API user account
GLIFIC_PASSWORD=

# Glific Flow IDs to trigger via startContactFlow (GLIFIC_SETUP.md §4 shows how to find one)
GLIFIC_FLOW_VERIFICATION_REQUEST=
GLIFIC_FLOW_BOATMAN_BROADCAST=
GLIFIC_FLOW_FACILITY_ALERT=
GLIFIC_FLOW_CASE_STATUS_UPDATE=
GLIFIC_FLOW_CASE_CLOSE=
GLIFIC_FLOW_AMBULANCE_DISPATCH=

# Exotel — direct Voice/SMS API, separate from Glific (GLIFIC_SETUP.md §2b)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=            # the ExoPhone used as caller ID for outbound calls/SMS
EXOTEL_IVR_APP_ID=           # the pre-built Play+Gather+Passthrough App (GLIFIC_SETUP.md §2b)

# Escalation timers (SOP.md PILOT DEFAULTs — replace once real numbers are confirmed)
VERIFICATION_TIMEOUT_MIN=5
BOATMAN_ESCALATION_MIN=10
